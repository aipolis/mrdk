.profile-page {
  min-height: 100vh;
  background: #f0f9ff;
  padding: 24rpx 31rpx calc(24rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
}

.user-card {
  display: flex;
  align-items: center;
  gap: 24rpx;
  padding: 32rpx 32rpx;
  margin-bottom: 24rpx;
  background: #fff;
  border-radius: 32rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.06);
  box-sizing: border-box;
}

.user-card__logged {
  position: relative;
  width: 100%;
  min-height: 48px;
  padding-bottom: 36rpx;
}

.user-card__main {
  display: flex;
  align-items: center;
  gap: 24rpx;
  width: 100%;
}

.user-meta {
  flex: 1;
  min-width: 0;
}

.avatar-ring {
  width: 48px;
  height: 48px;
  border-radius: 24px;
  background: #e63838;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.avatar-btn {
  padding: 0;
  margin: 0;
  border: none;
  background: transparent;
  line-height: 1;
  flex-shrink: 0;
}

.avatar-btn::after {
  border: none;
}

.avatar-img {
  width: 48px;
  height: 48px;
  border-radius: 24px;
  flex-shrink: 0;
  background: #f1f5f9;
}

.avatar-char {
  font-size: 20px;
  font-weight: 700;
  color: #fff;
}

.user-name {
  display: block;
  font-size: 36rpx;
  font-weight: 700;
  color: #0f172a;
}

.user-id {
  display: block;
  font-size: 24rpx;
  color: #64748b;
  margin-top: 8rpx;
}

.user-meta--login {
  flex: 1;
}

.nickname-input {
  width: 100%;
  font-size: 32rpx;
  font-weight: 600;
  color: #0f172a;
}

.login-hint {
  display: block;
  font-size: 22rpx;
  color: #64748b;
  margin-top: 10rpx;
}

.logout-link {
  position: absolute;
  right: 0;
  bottom: 0;
  font-size: 24rpx;
  color: #64748b;
}

.menu-card {
  background: #fff;
  border-radius: 32rpx;
  overflow: hidden;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.06);
}

.menu-row {
  display: flex;
  align-items: center;
  padding: 28rpx 32rpx;
  border-bottom: 1rpx solid #f1f5f9;
  min-height: 96rpx;
}

.menu-row.no-border {
  border-bottom: none;
}

.menu-label {
  flex: 1;
  font-size: 28rpx;
  color: #0f172a;
}

.menu-val {
  font-size: 24rpx;
  color: #64748b;
  margin-right: 8rpx;
}

.menu-arrow {
  font-size: 20px;
  color: #64748b;
}

.menu-row.tap:active {
  background: #f8fafc;
}
