.history-page {
  min-height: 100vh;
  background: #f0f9ff;
  padding: 24rpx 31rpx calc(24rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
}

.history-head {
  margin-bottom: 24rpx;
  padding-top: 8rpx;
}

.history-head-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}

.history-title {
  font-size: 44rpx;
  font-weight: 700;
  color: #0f172a;
  flex-shrink: 0;
}

.head-date-pill {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 52rpx;
  padding: 0 16rpx;
  background: #eff7fb;
  border-radius: 14rpx;
  flex-shrink: 0;
}

.head-date {
  font-size: 22rpx;
  font-weight: 500;
  color: #0284c7;
  white-space: nowrap;
  line-height: 1;
}

.history-sub {
  display: block;
  margin-top: 8rpx;
  font-size: 26rpx;
  color: #475569;
}

/* ── 走势图 ── */
.trend-card {
  background: #fff;
  border-radius: 32rpx;
  padding: 32rpx 38rpx 24rpx;
  margin-bottom: 24rpx;
  box-sizing: border-box;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.06);
}

.trend-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 24rpx;
}

.trend-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #0f172a;
  line-height: 1.3;
}

.trend-legend {
  display: flex;
  align-items: center;
  gap: 18rpx;
  flex-shrink: 0;
}

.legend-item {
  display: flex;
  align-items: center;
  gap: 6rpx;
  font-size: 22rpx;
  color: #475569;
  line-height: 1;
}

.legend-dot {
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  flex-shrink: 0;
}

.legend-dot--long { background: #e63838; }
.legend-dot--mid { background: #f59e0b; }
.legend-dot--empty { background: #91d1ed; }

.trend-bars {
  display: flex;
  align-items: flex-end;
  justify-content: center;
  gap: 0;
  height: 180rpx;
}

.trend-col {
  flex: 1;
  min-width: 0;
  height: 100%;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.trend-bar-wrap {
  flex: 1;
  width: 100%;
  display: flex;
  align-items: flex-end;
  justify-content: center;
}

.trend-bar {
  width: 88%;
  min-height: 8rpx;
  border-radius: 6rpx 6rpx 0 0;
}

.trend-bar--today {
  box-shadow: 0 0 0 3rpx #fff, 0 0 0 5rpx currentColor;
}

.trend-date {
  margin-top: 8rpx;
  font-size: 17rpx;
  color: #475569;
  line-height: 1;
  white-space: nowrap;
}

.trend-date--today {
  color: #e63838;
  font-weight: 600;
}

/* ── 周期切换 ── */
.period-tabs {
  display: flex;
  justify-content: center;
  gap: 12rpx;
  margin-top: 24rpx;
  padding-top: 20rpx;
  border-top: 1rpx solid #f1f5f9;
}

.period-tab {
  padding: 10rpx 32rpx;
  border-radius: 20rpx;
  background: #f1f5f9;
  font-size: 24rpx;
  color: #475569;
  transition: all 0.2s;
}

.period-tab--active {
  background: #0284c7;
  color: #fff;
}

/* ── 状态 ── */
.state-card {
  padding: 120rpx 32rpx;
  text-align: center;
  background: #fff;
  border-radius: 32rpx;
}

.state-text {
  color: #475569;
  font-size: 28rpx;
}

/* ── 列表 ── */
.list-card {
  background: #fff;
  border-radius: 32rpx;
  overflow: hidden;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.06);
}

.history-row {
  display: flex;
  align-items: center;
  padding: 28rpx 32rpx;
  border-bottom: 1rpx solid #f1f5f9;
  gap: 16rpx;
}

.history-row:last-child {
  border-bottom: none;
}

.history-date {
  width: 120rpx;
  font-size: 28rpx;
  font-weight: 600;
  color: #334155;
  flex-shrink: 0;
}

.history-emoji {
  font-size: 36rpx;
  flex-shrink: 0;
}

.history-line {
  flex: 1;
  text-align: right;
  font-size: 28rpx;
  font-weight: 500;
}
