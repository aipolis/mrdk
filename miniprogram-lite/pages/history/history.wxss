.history-page {
  min-height: 100vh;
  background: #f0f9ff;
  padding: 24rpx 31rpx calc(24rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
}

.history-head {
  margin-bottom: 24rpx;
  padding-top: 8rpx;
}

.history-head-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}

.history-title {
  font-size: 44rpx;
  font-weight: 700;
  color: #0f172a;
  flex-shrink: 0;
}

.head-date-pill {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 52rpx;
  padding: 0 16rpx;
  background: #eff7fb;
  border-radius: 14rpx;
  flex-shrink: 0;
}

.head-date {
  font-size: 22rpx;
  font-weight: 500;
  color: #0284c7;
  white-space: nowrap;
  line-height: 1;
}

.history-sub {
  display: block;
  margin-top: 8rpx;
  font-size: 26rpx;
  color: #475569;
}

/* ── 近10日统计摘要 ── */
.summary-card {
  background: #fff;
  border-radius: 24rpx;
  padding: 24rpx 32rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.06);
}

.summary-label {
  font-size: 22rpx;
  color: #94a3b8;
  font-weight: 500;
  display: block;
  margin-bottom: 16rpx;
}

.summary-tags {
  display: flex;
  gap: 12rpx;
  flex-wrap: wrap;
}

.summary-tag {
  display: flex;
  align-items: center;
  padding: 8rpx 20rpx;
  border-radius: 16rpx;
  font-size: 24rpx;
  font-weight: 500;
  line-height: 1.4;
}

.summary-tag--long  { background: #fef2f2; color: #b91c1c; }
.summary-tag--mid   { background: #fffbeb; color: #92400e; }
.summary-tag--empty { background: #f0f9ff; color: #0369a1; }

.summary-streak {
  display: block;
  margin-top: 14rpx;
  font-size: 22rpx;
  color: #64748b;
}

/* ── 图表/日历容器 ── */
.chart-card {
  background: #fff;
  border-radius: 32rpx;
  padding: 24rpx 32rpx 28rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.06);
}

/* ── 视图切换 tab ── */
.view-tabs {
  display: flex;
  background: #f1f5f9;
  border-radius: 16rpx;
  padding: 4rpx;
  margin-bottom: 28rpx;
}

.view-tab {
  flex: 1;
  text-align: center;
  padding: 12rpx 0;
  border-radius: 12rpx;
  font-size: 26rpx;
  color: #64748b;
  transition: all 0.2s;
}

.view-tab--active {
  background: #fff;
  color: #0f172a;
  font-weight: 600;
  box-shadow: 0 1rpx 6rpx rgba(0,0,0,0.08);
}

/* ── 月历 ── */
.cal-nav {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 20rpx;
}

.cal-nav-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #0f172a;
}

.cal-nav-btn {
  font-size: 48rpx;
  color: #94a3b8;
  padding: 0 16rpx;
  line-height: 1;
}

.cal-weekdays {
  display: grid;
  grid-template-columns: repeat(7, 1fr);
  margin-bottom: 8rpx;
}

.cal-wd {
  text-align: center;
  font-size: 22rpx;
  color: #94a3b8;
  font-weight: 500;
  padding: 8rpx 0;
}

.cal-grid {
  display: grid;
  grid-template-columns: repeat(7, 1fr);
  gap: 8rpx 4rpx;
}

.cal-cell {
  display: flex;
  align-items: center;
  justify-content: center;
}

.cal-day-wrap {
  width: 72rpx;
  height: 80rpx;
  border-radius: 14rpx;
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
}

.cal-day-wrap--today {
  border: 2rpx solid #0284c7;
}

.cal-score {
  font-size: 34rpx;
  font-weight: 700;
  color: #fff;
  line-height: 1;
}

.cal-day {
  position: absolute;
  right: 6rpx;
  bottom: 5rpx;
  font-size: 18rpx;
  color: #64748b;
  font-weight: 400;
  line-height: 1;
}

.cal-day--filled {
  color: rgba(255, 255, 255, 0.75);
  font-weight: 500;
}

.cal-day--today {
  color: #0284c7;
  font-weight: 700;
}

/* .trend-card 已合并到 .chart-card */
.trend-card {}

.trend-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 24rpx;
}

.trend-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #0f172a;
  line-height: 1.3;
}

.trend-legend {
  display: flex;
  align-items: center;
  gap: 18rpx;
  flex-shrink: 0;
}

.legend-item {
  display: flex;
  align-items: center;
  gap: 6rpx;
  font-size: 22rpx;
  color: #475569;
  line-height: 1;
}

.legend-dot {
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  flex-shrink: 0;
}

.legend-dot--long { background: #e63838; }
.legend-dot--mid { background: #f59e0b; }
.legend-dot--empty { background: #91d1ed; }

.trend-bars {
  display: flex;
  align-items: flex-end;
  justify-content: center;
  gap: 0;
  height: 180rpx;
}

.trend-col {
  flex: 1;
  min-width: 0;
  height: 100%;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.trend-bar-wrap {
  flex: 1;
  width: 100%;
  display: flex;
  align-items: flex-end;
  justify-content: center;
}

.trend-bar {
  width: 88%;
  min-height: 8rpx;
  border-radius: 6rpx 6rpx 0 0;
}

.trend-bar--today {
  box-shadow: 0 0 0 3rpx #fff, 0 0 0 5rpx currentColor;
}

.trend-date {
  margin-top: 8rpx;
  font-size: 17rpx;
  color: #475569;
  line-height: 1;
  white-space: nowrap;
}

.trend-date--today {
  color: #e63838;
  font-weight: 600;
}

/* ── 周期切换 ── */
.period-tabs {
  display: flex;
  justify-content: center;
  gap: 12rpx;
  margin-top: 24rpx;
  padding-top: 20rpx;
  border-top: 1rpx solid #f1f5f9;
}

.period-tab {
  padding: 10rpx 32rpx;
  border-radius: 20rpx;
  background: #f1f5f9;
  font-size: 24rpx;
  color: #475569;
  transition: all 0.2s;
}

.period-tab--active {
  background: #0284c7;
  color: #fff;
}

/* ── 状态 ── */
.state-card {
  padding: 120rpx 32rpx;
  text-align: center;
  background: #fff;
  border-radius: 32rpx;
}

.state-text {
  color: #475569;
  font-size: 28rpx;
}

/* ── 列表 ── */
.list-card {
  background: #fff;
  border-radius: 32rpx;
  overflow: hidden;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.06);
}

.history-row {
  display: flex;
  align-items: center;
  padding: 28rpx 32rpx;
  border-bottom: 1rpx solid #f1f5f9;
  gap: 16rpx;
}

.history-row:last-child {
  border-bottom: none;
}

.history-date {
  width: 120rpx;
  font-size: 28rpx;
  font-weight: 600;
  color: #334155;
  flex-shrink: 0;
}

.history-emoji {
  font-size: 36rpx;
  flex-shrink: 0;
}

.history-line {
  flex: 1;
  text-align: right;
  font-size: 28rpx;
  font-weight: 500;
}
