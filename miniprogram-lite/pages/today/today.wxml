<view class="page today-page {{themeClass}}">
  <!-- 页头 -->
  <view class="today-head">
    <view class="head-row">
      <text class="brand">{{appTitle}}</text>
      <view class="head-date-pill">
        <text class="head-date">{{headerDate}}</text>
      </view>
    </view>
    <text class="head-subtitle">{{appSubtitle}}</text>
  </view>

  <view wx:if="{{loading && !pageReady}}" class="state-card">
    <text class="state-text">正在读取今日天气…</text>
  </view>

  <view wx:elif="{{error}}" class="state-card">
    <text class="state-text">{{error}}</text>
    <text class="state-hint">下拉刷新重试</text>
  </view>

  <block wx:else>
    <!-- 今日天气卡片 -->
    <view class="hero-card">
      <view class="hero-top">
        <text class="hero-title">今日舒适度</text>
        <view class="hero-update" wx:if="{{updateBadge}}">
          <text class="hero-update-text">{{updateBadge}}</text>
        </view>
      </view>

      <view class="hero-body">
        <view class="hero-score-wrap">
          <text class="hero-score" style="color: {{scoreColor}};">{{displayScore}}</text>
        </view>
        <text class="hero-verdict">{{verdictChar}}·{{weatherShort}}</text>
        <!-- 连续天数 -->
        <view class="streak-badge" wx:if="{{streakText}}">
          <text class="streak-text">{{streakText}}</text>
        </view>
        <view class="hero-divider"/>
        <text class="hero-desc">{{weatherText}}，{{actionText}}</text>
      </view>

      <!-- 今日解读 -->
      <view class="insight-row" wx:if="{{insight}}">
        <text class="insight-label">今日解读</text>
        <text class="insight-text" user-select="all">{{insight}}</text>
      </view>

      <view class="hero-pills">
        <view
          wx:for="{{verdictTabs}}"
          wx:key="key"
          class="hero-pill {{item.pillClass}} {{verdictKey === item.key ? 'hero-pill--active' : ''}}"
          style="{{verdictKey === item.key ? 'background:' + scoreColor + ';' : ''}}"
        >
          <image class="pill-icon" src="{{item.icon}}" mode="aspectFit"/>
          <text class="pill-char">{{item.char}}</text>
          <text class="pill-hint">·{{item.actionHint}}</text>
        </view>
      </view>
    </view>

    <!-- 近10日走势 -->
    <view class="trend-card" wx:if="{{trendBars.length}}">
      <view class="trend-head">
        <text class="trend-title">近10日天气走势</text>
        <view class="trend-legend">
          <view class="legend-item">
            <view class="legend-dot legend-dot--long"/>
            <text>龙</text>
          </view>
          <view class="legend-item">
            <view class="legend-dot legend-dot--mid"/>
            <text>中</text>
          </view>
          <view class="legend-item">
            <view class="legend-dot legend-dot--empty"/>
            <text>空</text>
          </view>
        </view>
      </view>
      <view class="trend-bars">
        <view
          wx:for="{{trendBars}}"
          wx:key="fullDate"
          class="trend-col"
          bindtap="onBarTap"
          data-index="{{index}}"
        >
          <text
            class="bar-score-label {{item.isToday ? 'bar-score-label--today' : ''}}"
            style="color: {{item.color}};"
            wx:if="{{item.isToday || index >= trendBars.length - 3}}"
          >{{item.score}}</text>
          <view class="trend-bar-wrap">
            <view
              class="trend-bar {{item.isToday ? 'trend-bar--today' : ''}} {{barDetail && barDetail.fullDate === item.fullDate ? 'trend-bar--selected' : ''}}"
              style="height: {{item.heightPct}}%; background-color: {{item.color}};"
            />
          </view>
          <text class="trend-date {{item.isToday ? 'trend-date--today' : ''}}">{{item.dateLabel}}</text>
        </view>
      </view>
    </view>

    <!-- 柱图点击详情弹窗 -->
    <view class="bar-popup-mask" wx:if="{{barDetail}}" bindtap="onCloseBarDetail">
      <view class="bar-popup" catchtap="noop">
        <view class="bar-popup-header" style="background: {{barDetail.color}}20;">
          <text class="bar-popup-date">{{barDetail.fullDate}}</text>
          <text class="bar-popup-close" bindtap="onCloseBarDetail">×</text>
        </view>
        <view class="bar-popup-body">
          <text class="bar-popup-score" style="color: {{barDetail.color}};">{{barDetail.score}}</text>
          <view class="bar-popup-tag" style="background: {{barDetail.color}}20; color: {{barDetail.color}};">
            <text>{{barDetail.verdictLabel}}</text>
          </view>
        </view>
      </view>
    </view>

    <!-- 每日语录（按日期轮换） -->
    <view class="quote-card">
      <view class="quote-card-head">
        <text class="quote-card-title">与君共勉</text>
        <text class="quote-card-tag">今日精选</text>
      </view>
      <view class="quote-box quote-box--blue">
        <text class="quote-text" user-select="all">{{dailyQuote.text}}</text>
        <text class="quote-author">—— {{dailyQuote.author}}</text>
      </view>
    </view>

    <!-- 订阅 / 已订阅后改为分享 -->
    <view class="subscribe-wrap">
      <!-- 未订阅：订阅按钮 -->
      <block wx:if="{{!subscribed}}">
        <button class="subscribe-btn" bindtap="onSubscribe">
          <text class="subscribe-text">预约明日 9:10 天气提醒</text>
          <view class="subscribe-bell">
            <image class="subscribe-icon" src="/images/icon-bell.png" mode="aspectFit"/>
            <text class="subscribe-bell-text">立即预约</text>
          </view>
        </button>
        <text class="subscribe-hint">受品类限制，每次预约仅次日有效；如需持续提醒，建议每晚睡前订阅一次</text>
      </block>

      <!-- 已订阅：提示 + 分享 -->
      <view wx:else class="subscribed-row">
        <view class="subscribed-done">
          <text class="subscribed-check">✓</text>
          <text class="subscribed-label">明日提醒已预约</text>
        </view>
        <button class="share-btn" open-type="share">
          <text class="share-btn-text">分享给朋友</text>
        </button>
      </view>
    </view>
  </block>
</view>
