/**
 * 设计稿 Page 1.svg · 画布 390×948
 * rpx 换算：750 / 390 ≈ 1.923
 */

page {
  background: #f0f9ff;
}

.today-page {
  min-height: 100vh;
  padding: 0 31rpx calc(0rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
  background: #f0f9ff;
}

/* ── 页头 ── */
.today-head {
  padding-top: 20rpx;
  margin-bottom: 31rpx;
}

.head-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}

.brand {
  font-size: 44rpx;
  font-weight: 700;
  color: #0f172a;
  line-height: 1.25;
  flex-shrink: 0;
}

.head-date-pill {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 52rpx;
  padding: 0 16rpx;
  background: #eff7fb;
  border-radius: 14rpx;
  flex-shrink: 0;
}

.head-date {
  font-size: 22rpx;
  font-weight: 500;
  color: #0284c7;
  white-space: nowrap;
  line-height: 1;
}

.head-subtitle {
  display: block;
  margin-top: 10rpx;
  font-size: 26rpx;
  color: #475569;
  line-height: 1.45;
}

/* ── 状态 ── */
.state-card {
  padding: 120rpx 32rpx;
  text-align: center;
  background: #fff;
  border-radius: 32rpx;
}

.state-text {
  color: #475569;
  font-size: 28rpx;
}

.state-hint {
  display: block;
  margin-top: 12rpx;
  font-size: 24rpx;
  color: #64748b;
}

/* ── 通用卡片 ── */
.hero-card,
.trend-card,
.quote-card {
  background: #fff;
  border-radius: 32rpx;
  margin-bottom: 23rpx;
  box-sizing: border-box;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.06);
}

/* ── 今日天气 ── */
.hero-card {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 30rpx 32rpx 18rpx;
}

.hero-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
  width: 100%;
  gap: 12rpx;
  margin-bottom: 8rpx;
}

.hero-title {
  font-size: 26rpx;
  font-weight: 400;
  color: #475569;
  line-height: 1.4;
}

.hero-update {
  display: flex;
  align-items: center;
  height: 38rpx;
  padding: 0 12rpx;
  background: #f0fdf4;
  border-radius: 8rpx;
  flex-shrink: 0;
}

.hero-update-text {
  font-size: 20rpx;
  font-weight: 500;
  color: #16a34a;
  white-space: nowrap;
  line-height: 1.2;
}

/* 天气结论 — 大字温度 + 结论 + 分割线 + 描述 */
.hero-body {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 8rpx 0 20rpx;
}

.hero-score-wrap {
  display: flex;
  align-items: flex-start;
  justify-content: center;
}

.hero-score {
  font-size: 168rpx;
  font-weight: 400;
  font-family: -apple-system, 'Helvetica Neue', Helvetica, sans-serif;
  line-height: 1;
  letter-spacing: -6rpx;
}

/* ── 走势柱选中高亮 ── */
.trend-bar--selected {
  opacity: 0.75;
  box-shadow: 0 0 0 3rpx #fff, 0 0 0 6rpx currentColor;
}

/* ── 柱图点击详情弹窗 ── */
.bar-popup-mask {
  position: fixed;
  top: 0; left: 0; right: 0; bottom: 0;
  background: rgba(0,0,0,0.3);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 100;
}

.bar-popup {
  width: 480rpx;
  background: #fff;
  border-radius: 28rpx;
  overflow: hidden;
  box-shadow: 0 8rpx 40rpx rgba(0,0,0,0.18);
}

.bar-popup-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx 28rpx 20rpx;
}

.bar-popup-date {
  font-size: 26rpx;
  font-weight: 600;
  color: #334155;
}

.bar-popup-close {
  font-size: 40rpx;
  color: #94a3b8;
  line-height: 1;
  padding: 0 4rpx;
}

.bar-popup-body {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 24rpx 28rpx 36rpx;
  gap: 16rpx;
}

.bar-popup-score {
  font-size: 120rpx;
  font-weight: 300;
  line-height: 1;
  letter-spacing: -4rpx;
}

.bar-popup-tag {
  padding: 8rpx 28rpx;
  border-radius: 20rpx;
  font-size: 26rpx;
  font-weight: 600;
}

/* 分数颜色由 JS getScoreColor 计算后 inline style 注入 */

.hero-verdict {
  display: block;
  margin-top: 16rpx;
  font-size: 32rpx;
  font-weight: 600;
  color: #334155;
  line-height: 1.3;
}

.hero-divider {
  width: 48rpx;
  height: 4rpx;
  border-radius: 2rpx;
  background: #cbd5e1;
  margin: 14rpx 0;
}

.hero-desc {
  display: block;
  font-size: 26rpx;
  font-weight: 400;
  color: #475569;
  line-height: 1.45;
}

/* 三列 pill — 设计 101×35/33px */
.hero-pills {
  display: flex;
  gap: 14rpx;
  width: 100%;
  position: relative;
}

.hero-pill {
  flex: 1;
  border-radius: 14rpx;
  display: flex;
  flex-direction: row;
  align-items: baseline;
  justify-content: center;
  padding: 0 4rpx;
  gap: 6rpx;
  height: 64rpx;
  line-height: 64rpx;
  box-sizing: border-box;
  transition: all 0.2s;
  position: relative;
}

/* 默认（未命中）：灰底灰字 */
.pill-long,
.pill-mid,
.pill-empty {
  background: #f1f5f9;
}

/* 命中时：背景由 inline style 注入（7色方案），保留阴影 */
.hero-pill--active { box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.25); }

.pill-icon {
  width: 28rpx;
  height: 28rpx;
  flex-shrink: 0;
  align-self: center;
  filter: brightness(0) saturate(0) opacity(0.35);
}

/* 命中时图标恢复彩色/白色 */
.hero-pill--active .pill-icon { filter: none; }
.hero-pill--active.pill-mid .pill-icon { filter: brightness(0) invert(1); }

.pill-char {
  font-size: 28rpx;
  font-weight: 700;
  color: #94a3b8;
  line-height: 64rpx;
}

.pill-hint {
  font-size: 20rpx;
  font-weight: 500;
  color: #94a3b8;
  line-height: 64rpx;
}

/* 命中时文字统一白色 */
.hero-pill--active .pill-char,
.hero-pill--active .pill-hint { color: #fff; }

/* ── 走势 358×186 ── */
.trend-card {
  padding: 32rpx 38rpx 24rpx;
}

.trend-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 24rpx;
}

.trend-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #0f172a;
  line-height: 1.3;
}

.trend-legend {
  display: flex;
  align-items: center;
  gap: 18rpx;
  flex-shrink: 0;
}

.legend-item {
  display: flex;
  align-items: center;
  gap: 6rpx;
  font-size: 22rpx;
  color: #475569;
  line-height: 1;
}

.legend-dot {
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  flex-shrink: 0;
}

.legend-dot--long { background: #e63838; }
.legend-dot--mid { background: #f59e0b; }
.legend-dot--empty { background: #91d1ed; }

/* 柱状图 — 设计柱宽 31px ≈ 60rpx，中心间距 31px（紧邻） */
.trend-bars {
  display: flex;
  align-items: flex-end;
  justify-content: center;
  gap: 0;
  height: 200rpx;
}

.trend-col {
  flex: 1;
  min-width: 0;
  height: 100%;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.trend-bar-wrap {
  flex: 1;
  width: 100%;
  display: flex;
  align-items: flex-end;
  justify-content: center;
}

.trend-bar {
  width: 88%;
  min-height: 8rpx;
  border-radius: 6rpx 6rpx 0 0;
}

.trend-bar--today {
  opacity: 1;
  box-shadow: 0 0 0 3rpx #fff, 0 0 0 5rpx currentColor;
}

.trend-date {
  margin-top: 10rpx;
  font-size: 18rpx;
  color: #475569;
  line-height: 1;
  white-space: nowrap;
}

.trend-date--today {
  color: #e63838;
  font-weight: 700;
}

/* ── 连续天数徽章 ── */
.streak-badge {
  margin-top: 10rpx;
  display: inline-flex;
  align-items: center;
  padding: 6rpx 20rpx;
  background: rgba(0, 0, 0, 0.06);
  border-radius: 24rpx;
}

.streak-text {
  font-size: 22rpx;
  font-weight: 500;
  color: #475569;
  line-height: 1.3;
}

.weather-long .streak-badge { background: rgba(230, 56, 56, 0.1); }
.weather-long .streak-text  { color: #b91c1c; }
.weather-mid  .streak-badge { background: rgba(245, 166, 10, 0.1); }
.weather-mid  .streak-text  { color: #92400e; }
.weather-empty .streak-badge { background: rgba(145, 209, 237, 0.2); }
.weather-empty .streak-text  { color: #0369a1; }

/* ── 今日解读 ── */
.insight-row {
  width: 100%;
  margin: 18rpx 0 14rpx;
  padding: 20rpx 24rpx;
  background: #f8fafc;
  border-radius: 16rpx;
  box-sizing: border-box;
}

.insight-label {
  display: block;
  font-size: 20rpx;
  font-weight: 600;
  color: #94a3b8;
  margin-bottom: 8rpx;
  letter-spacing: 1rpx;
}

.insight-text {
  display: block;
  font-size: 26rpx;
  line-height: 1.65;
  color: #334155;
}

/* ── 走势柱顶分数标注 ── */
.bar-score-label {
  font-size: 18rpx;
  font-weight: 600;
  line-height: 1.2;
  margin-bottom: 4rpx;
  text-align: center;
}

.bar-score-label--today {
  font-size: 20rpx;
  font-weight: 800;
}

/* ── 游资语录 358×222 ── */
.quote-card {
  padding: 32rpx 38rpx 28rpx;
}

.quote-card-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 20rpx;
}

.quote-card-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #0f172a;
  line-height: 1.3;
}

.quote-card-tag {
  font-size: 22rpx;
  font-weight: 500;
  color: #0284c7;
  background: #eff7fb;
  padding: 4rpx 14rpx;
  border-radius: 10rpx;
  line-height: 1.5;
}

.quote-box {
  border-radius: 16rpx;
  padding: 24rpx 28rpx 20rpx;
  box-sizing: border-box;
}

.quote-box--blue {
  background: #f0f9ff;
  margin-bottom: 12rpx;
}

.quote-box--yellow {
  background: #fefce8;
}

.quote-text {
  display: block;
  font-size: 28rpx;
  font-weight: 400;
  line-height: 1.65;
  color: #334155;
}

.quote-author {
  display: block;
  margin-top: 16rpx;
  font-size: 24rpx;
  color: #64748b;
  text-align: right;
  line-height: 1.4;
}

/* ── 订阅按钮 ── */
.subscribe-wrap {
  padding: 0;
  margin-top: 8rpx;
}

.subscribe-btn {
  width: 100%;
  height: 104rpx;
  padding: 0 24rpx 0 40rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12rpx;
  background: #0284c7;
  color: #fff;
  border-radius: 24rpx;
  border: none;
  box-sizing: border-box;
}

.subscribe-btn--done {
  background: #cbd5e1;
}

.subscribe-btn::after {
  border: none;
}

.subscribe-text {
  font-size: 30rpx;
  font-weight: 600;
  line-height: 1;
  color: #fff;
  flex: 1;
  text-align: left;
  white-space: nowrap;
}

.subscribe-btn--done .subscribe-text {
  color: #475569;
}

.subscribe-bell {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 10rpx;
  height: 72rpx;
  padding: 0 24rpx;
  background: #fff;
  border-radius: 18rpx;
  flex-shrink: 0;
}

.subscribe-icon {
  width: 36rpx;
  height: 36rpx;
  flex-shrink: 0;
}

.subscribe-bell--done {
  background: rgba(255, 255, 255, 0.6);
}

.subscribe-bell-text {
  font-size: 26rpx;
  font-weight: 400;
  color: #0284c7;
  white-space: nowrap;
  line-height: 1;
}

.subscribe-bell--done .subscribe-bell-text {
  color: #94a3b8;
}

.subscribe-hint {
  display: block;
  margin-top: 14rpx;
  font-size: 22rpx;
  color: #94a3b8;
  line-height: 1.6;
  text-align: center;
  padding: 0 8rpx;
}

/* ── 已订阅后：提示 + 分享 ── */
.subscribed-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  padding: 0 8rpx;
}

.subscribed-done {
  display: flex;
  align-items: center;
  gap: 12rpx;
  flex: 1;
  min-width: 0;
}

.subscribed-check {
  font-size: 32rpx;
  color: #16a34a;
  line-height: 1;
  flex-shrink: 0;
}

.subscribed-label {
  font-size: 26rpx;
  color: #475569;
  line-height: 1.4;
}

.share-btn {
  flex-shrink: 0;
  height: 72rpx;
  padding: 0 32rpx;
  background: #0284c7;
  color: #fff;
  border-radius: 18rpx;
  border: none;
  display: flex;
  align-items: center;
  justify-content: center;
  line-height: 1;
}

.share-btn::after {
  border: none;
}

.share-btn-text {
  font-size: 26rpx;
  font-weight: 600;
  color: #fff;
  line-height: 1;
}
