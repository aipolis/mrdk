/**
 * 设计稿 Page 1.svg · 画布 390×948
 * rpx 换算：750 / 390 ≈ 1.923
 */

page {
  background: #f0f9ff;
}

.today-page {
  min-height: 100vh;
  padding: 0 31rpx calc(0rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
  background: #f0f9ff;
}

/* ── 页头 ── */
.today-head {
  padding-top: 20rpx;
  margin-bottom: 31rpx;
}

.head-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}

.brand {
  font-size: 44rpx;
  font-weight: 700;
  color: #0f172a;
  line-height: 1.25;
  flex-shrink: 0;
}

.head-date-pill {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 52rpx;
  padding: 0 16rpx;
  background: #eff7fb;
  border-radius: 14rpx;
  flex-shrink: 0;
}

.head-date {
  font-size: 22rpx;
  font-weight: 500;
  color: #0284c7;
  white-space: nowrap;
  line-height: 1;
}

.head-subtitle {
  display: block;
  margin-top: 10rpx;
  font-size: 26rpx;
  color: #475569;
  line-height: 1.45;
}

/* ── 状态 ── */
.state-card {
  padding: 120rpx 32rpx;
  text-align: center;
  background: #fff;
  border-radius: 32rpx;
}

.state-text {
  color: #475569;
  font-size: 28rpx;
}

.state-hint {
  display: block;
  margin-top: 12rpx;
  font-size: 24rpx;
  color: #64748b;
}

/* ── 通用卡片 ── */
.hero-card,
.trend-card,
.quote-card {
  background: #fff;
  border-radius: 32rpx;
  margin-bottom: 23rpx;
  box-sizing: border-box;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.06);
}

/* ── 今日天气 ── */
.hero-card {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 30rpx 32rpx 18rpx;
}

.hero-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
  width: 100%;
  gap: 12rpx;
  margin-bottom: 8rpx;
}

.hero-title {
  font-size: 26rpx;
  font-weight: 400;
  color: #475569;
  line-height: 1.4;
}

.hero-update {
  display: flex;
  align-items: center;
  height: 38rpx;
  padding: 0 12rpx;
  background: #f0fdf4;
  border-radius: 8rpx;
  flex-shrink: 0;
}

.hero-update-text {
  font-size: 20rpx;
  font-weight: 500;
  color: #16a34a;
  white-space: nowrap;
  line-height: 1.2;
}

/* 天气结论 — 大字温度 + 结论 + 分割线 + 描述 */
.hero-body {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 8rpx 0 20rpx;
}

.hero-score-wrap {
  display: flex;
  align-items: flex-start;
  justify-content: center;
  padding-left: 16rpx;
}

.hero-score {
  font-size: 168rpx;
  font-weight: 400;
  font-family: -apple-system, 'Helvetica Neue', Helvetica, sans-serif;
  line-height: 1;
  letter-spacing: -6rpx;
}

.hero-score-degree {
  font-size: 80rpx;
  font-weight: 400;
  font-family: -apple-system, 'Helvetica Neue', Helvetica, sans-serif;
  line-height: 1;
  margin-top: 12rpx;
  margin-left: 2rpx;
}

.weather-long .hero-score,
.weather-long .hero-score-degree { color: #e63838; }
.weather-mid .hero-score,
.weather-mid .hero-score-degree { color: #f5a60a; }
.weather-empty .hero-score,
.weather-empty .hero-score-degree { color: #91d1ed; }

.hero-verdict {
  display: block;
  margin-top: 16rpx;
  font-size: 32rpx;
  font-weight: 600;
  color: #334155;
  line-height: 1.3;
}

.hero-divider {
  width: 48rpx;
  height: 4rpx;
  border-radius: 2rpx;
  background: #cbd5e1;
  margin: 14rpx 0;
}

.hero-desc {
  display: block;
  font-size: 26rpx;
  font-weight: 400;
  color: #475569;
  line-height: 1.45;
}

/* 三列 pill — 设计 101×35/33px */
.hero-pills {
  display: flex;
  gap: 14rpx;
  width: 100%;
  position: relative;
}

.hero-pill {
  flex: 1;
  border-radius: 14rpx;
  display: flex;
  flex-direction: row;
  align-items: baseline;
  justify-content: center;
  padding: 0 4rpx;
  gap: 6rpx;
  height: 64rpx;
  line-height: 64rpx;
  box-sizing: border-box;
  transition: all 0.2s;
  position: relative;
}

.hero-pill--active {
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.2);
}

.pill-long { background: #e63838; }
.pill-mid { background: #f5a60a; }
.pill-empty { background: #91d1ed; }

.pill-icon {
  width: 28rpx;
  height: 28rpx;
  flex-shrink: 0;
  align-self: center;
}

.pill-mid .pill-icon {
  filter: brightness(0) invert(1);
}

.pill-char {
  font-size: 28rpx;
  font-weight: 700;
  color: #fff;
  line-height: 64rpx;
}

.pill-hint {
  font-size: 20rpx;
  font-weight: 500;
  color: #fff;
  line-height: 64rpx;
}

.pill-empty .pill-char,
.pill-empty .pill-hint {
  color: #1e293b;
}

/* ── 走势 358×186 ── */
.trend-card {
  padding: 32rpx 38rpx 24rpx;
}

.trend-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 24rpx;
}

.trend-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #0f172a;
  line-height: 1.3;
}

.trend-legend {
  display: flex;
  align-items: center;
  gap: 18rpx;
  flex-shrink: 0;
}

.legend-item {
  display: flex;
  align-items: center;
  gap: 6rpx;
  font-size: 22rpx;
  color: #475569;
  line-height: 1;
}

.legend-dot {
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  flex-shrink: 0;
}

.legend-dot--long { background: #e63838; }
.legend-dot--mid { background: #f59e0b; }
.legend-dot--empty { background: #91d1ed; }

/* 柱状图 — 设计柱宽 31px ≈ 60rpx，中心间距 31px（紧邻） */
.trend-bars {
  display: flex;
  align-items: flex-end;
  justify-content: center;
  gap: 0;
  height: 200rpx;
}

.trend-col {
  flex: 1;
  min-width: 0;
  height: 100%;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.trend-bar-wrap {
  flex: 1;
  width: 100%;
  display: flex;
  align-items: flex-end;
  justify-content: center;
}

.trend-bar {
  width: 88%;
  min-height: 8rpx;
  border-radius: 6rpx 6rpx 0 0;
}

.trend-bar--today {
  opacity: 1;
  box-shadow: 0 0 0 3rpx #fff, 0 0 0 5rpx currentColor;
}

.trend-date {
  margin-top: 10rpx;
  font-size: 18rpx;
  color: #475569;
  line-height: 1;
  white-space: nowrap;
}

.trend-date--today {
  color: #e63838;
  font-weight: 700;
}

/* ── 游资语录 358×222 ── */
.quote-card {
  padding: 32rpx 38rpx 28rpx;
}

.quote-card-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 20rpx;
}

.quote-card-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #0f172a;
  line-height: 1.3;
}

.quote-card-more {
  font-size: 26rpx;
  font-weight: 400;
  color: #0284c7;
  line-height: 1.3;
}

.quote-box {
  border-radius: 16rpx;
  padding: 24rpx 28rpx 20rpx;
  box-sizing: border-box;
}

.quote-box--blue {
  background: #f0f9ff;
  margin-bottom: 12rpx;
}

.quote-box--yellow {
  background: #fefce8;
}

.quote-text {
  display: block;
  font-size: 28rpx;
  font-weight: 400;
  line-height: 1.65;
  color: #334155;
}

.quote-author {
  display: block;
  margin-top: 16rpx;
  font-size: 24rpx;
  color: #64748b;
  text-align: right;
  line-height: 1.4;
}

/* ── 订阅按钮 ── */
.subscribe-wrap {
  padding: 0;
  margin-top: 8rpx;
}

.subscribe-btn {
  width: 100%;
  height: 104rpx;
  padding: 0 24rpx 0 40rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12rpx;
  background: #0284c7;
  color: #fff;
  border-radius: 24rpx;
  border: none;
  box-sizing: border-box;
}

.subscribe-btn--done {
  background: #cbd5e1;
}

.subscribe-btn::after {
  border: none;
}

.subscribe-text {
  font-size: 30rpx;
  font-weight: 600;
  line-height: 1;
  color: #fff;
  flex: 1;
  text-align: left;
}

.subscribe-btn--done .subscribe-text {
  color: #475569;
}

.subscribe-bell {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 10rpx;
  height: 72rpx;
  padding: 0 24rpx;
  background: #fff;
  border-radius: 18rpx;
  flex-shrink: 0;
}

.subscribe-icon {
  width: 36rpx;
  height: 36rpx;
  flex-shrink: 0;
}

.subscribe-bell--done {
  background: rgba(255, 255, 255, 0.6);
}

.subscribe-bell-text {
  font-size: 26rpx;
  font-weight: 400;
  color: #0284c7;
  white-space: nowrap;
  line-height: 1;
}

.subscribe-bell--done .subscribe-bell-text {
  color: #94a3b8;
}
