@import '../../styles/theme.wxss';

.history-page {
  padding-top: 16rpx;
}

/* ── 走势图 ── */
.trend-card {
  margin-bottom: 24rpx;
  padding: 24rpx 16rpx 16rpx;
}

.trend-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 12rpx;
  padding: 0 8rpx;
}

.trend-title {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--mr-text-headline);
}

.trend-canvas {
  width: 100%;
  height: 260rpx;
  display: block;
}

.period-tabs {
  display: flex;
  justify-content: center;
  gap: 12rpx;
  margin-top: 16rpx;
  padding-top: 16rpx;
  border-top: 1rpx solid var(--mr-table-border);
}

.period-tab {
  padding: 8rpx 28rpx;
  border-radius: 20rpx;
  background: var(--mr-day-pill-bg);
  font-size: 24rpx;
  color: var(--mr-text-muted);
}

.period-tab--active {
  background: #ff4d4f;
  color: #fff;
}

/* ── 列表 ── */
.page-top {
  margin-bottom: 24rpx;
}

.day-pill {
  display: inline-block;
  font-size: 28rpx;
  font-weight: 500;
  padding: 10rpx 24rpx;
  border-radius: 8rpx;
  color: var(--mr-text-muted);
  background: var(--mr-day-pill-bg);
  border: 1rpx solid var(--mr-day-pill-border);
  line-height: 1.35;
}

.day-pill.active {
  background: rgba(255, 77, 79, 0.12);
  color: #ff4d4f;
  font-weight: 600;
  border-color: rgba(255, 77, 79, 0.28);
}

.table-card {
  padding: 8rpx 16rpx 16rpx;
}

.table-header,
.table-row {
  display: flex;
  align-items: center;
  padding: 20rpx 0;
  font-size: 28rpx;
  line-height: 1.4;
}

.table-header {
  color: var(--mr-text-muted);
  font-size: 24rpx;
  font-weight: 500;
  border-bottom: 1rpx solid var(--mr-table-border);
  padding-bottom: 16rpx;
}

.table-row {
  color: var(--mr-text-body);
  border-bottom: 1rpx solid var(--mr-table-row-border);
}

.table-row:last-child {
  border-bottom: none;
}

.col-date { flex: 1.6; color: var(--mr-text-secondary); font-weight: 400; }
.col-score { flex: 1; text-align: center; font-weight: 700; font-size: 32rpx; font-variant-numeric: tabular-nums; }
.col-level { flex: 1.8; text-align: center; }
.col-index { flex: 1.5; text-align: center; font-weight: 600; font-variant-numeric: tabular-nums; }

.table-body {
  max-height: calc(100vh - 280rpx);
}

.empty-tip {
  text-align: center;
  padding: 80rpx 0;
  color: var(--mr-text-muted);
  font-size: 28rpx;
  line-height: 1.5;
}
