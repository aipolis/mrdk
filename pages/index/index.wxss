@import '../../styles/theme.wxss';
@import '../../styles/quote.wxss';

.page {
  padding-top: 0;
}

.header--fixed {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  z-index: 200;
  padding-left: 32rpx;
  padding-right: 32rpx;
  padding-bottom: 24rpx;
  background: var(--mr-bg-page);
  border-bottom: 1rpx solid var(--mr-border-light);
  box-sizing: border-box;
}

.header-cap-safe {
  width: 100%;
  flex-shrink: 0;
}

.header-row {
  position: relative;
  display: flex;
  align-items: center;
  min-height: 40px;
  width: 100%;
  box-sizing: border-box;
}

.header-left {
  display: flex;
  align-items: center;
  gap: 16rpx;
  flex: 1;
  min-width: 0;
  padding-right: 16rpx;
}

.header-right {
  position: absolute;
  right: 0;
  top: 0;
  bottom: 0;
  display: flex;
  align-items: center;
  justify-content: flex-end;
  gap: 12rpx;
  flex-shrink: 0;
}

.header-spacer {
  flex-shrink: 0;
}

.header-date {
  font-size: 24rpx;
  font-weight: 400;
  color: var(--mr-text-secondary);
  line-height: 1.4;
  white-space: nowrap;
  flex-shrink: 0;
}

.logo-img {
  width: 32px;
  height: 32px;
  border-radius: 8px;
  border: 1px solid var(--mr-logo-border);
}

.brand-name {
  font-size: 36rpx;
  font-weight: 700;
  color: var(--mr-text-headline);
  line-height: 1.25;
}

.loading-wrap { padding-top: 8rpx; }

.sk-card {
  height: 100rpx;
  background: var(--mr-bg-skeleton);
  border-radius: 16rpx;
  margin-bottom: 16rpx;
  border: 1rpx solid var(--mr-border-light);
}

.sk-mid { height: 340rpx; }
.sk-short { height: 180rpx; }

/* 与君共勉 */
.quote-bar {
  padding: 24rpx;
  margin-bottom: 24rpx;
}

.quote-bar .mr-pill {
  display: inline-flex;
  margin-bottom: 16rpx;
}

.quote-text {
  display: block;
  font-size: 28rpx;
  color: var(--mr-quote-text);
  line-height: 1.6;
  text-align: center;
}

.quote-hand {
  font-size: 32rpx;
  line-height: 1.65;
  letter-spacing: 0;
  color: var(--mr-quote-hand);
}

.quote-from {
  display: block;
  font-size: 24rpx;
  font-weight: 400;
  color: var(--mr-text-muted);
  margin-top: 16rpx;
  text-align: right;
  line-height: 1.4;
}

/* 情绪仪表盘 */
.gauge-card {
  padding: 24rpx;
  margin-bottom: 24rpx;
}

.gauge-head {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 8rpx;
}

.gauge-title {
  font-size: 32rpx;
  font-weight: 600;
  color: var(--mr-text-primary);
  line-height: 1.35;
}

.gauge-time {
  font-size: 24rpx;
  font-weight: 400;
  color: var(--mr-text-muted);
  line-height: 1.4;
}

.gauge-wheel-wrap {
  position: relative;
}

.gauge-level-row {
  text-align: center;
  padding: 8rpx 0 12rpx;
}

.gauge-level {
  display: block;
  font-size: 32rpx;
  font-weight: 700;
  line-height: 1.3;
}

.gauge-level.optimistic { color: #f87171; }
.gauge-level.climax { color: #f87171; }
.gauge-level.frenzy { color: #ef4444; }
.gauge-level.neutral { color: #fbbf24; }
.gauge-level.caution { color: #4ade80; }
.gauge-level.cold { color: #60a5fa; }
.gauge-level.calculating { color: var(--mr-text-secondary); }

.gauge-desc {
  display: block;
  font-size: 28rpx;
  font-weight: 400;
  color: var(--mr-text-secondary);
  margin-top: 8rpx;
  line-height: 1.5;
  padding: 0 8rpx;
}

.longkong-state {
  margin: 12rpx 0 16rpx;
  padding: 24rpx 24rpx 20rpx;
  border-radius: 24rpx;
  background: linear-gradient(180deg, rgba(22, 28, 44, 0.95), rgba(14, 18, 30, 0.98));
  border: 1rpx solid var(--mr-border-light);
  box-shadow: inset 0 1rpx 0 rgba(255, 255, 255, 0.04);
}

.longkong-state.frenzy,
.longkong-state.climax,
.longkong-state.optimistic {
  border-color: rgba(248, 113, 113, 0.28);
  box-shadow: 0 0 32rpx rgba(248, 113, 113, 0.08), inset 0 1rpx 0 rgba(255, 255, 255, 0.05);
}
.longkong-state.neutral {
  border-color: rgba(251, 191, 36, 0.28);
  box-shadow: 0 0 32rpx rgba(251, 191, 36, 0.07), inset 0 1rpx 0 rgba(255, 255, 255, 0.05);
}
.longkong-state.caution {
  border-color: rgba(74, 222, 128, 0.28);
  box-shadow: 0 0 32rpx rgba(74, 222, 128, 0.07), inset 0 1rpx 0 rgba(255, 255, 255, 0.05);
}
.longkong-state.weak {
  border-color: rgba(56, 189, 248, 0.28);
  box-shadow: 0 0 32rpx rgba(56, 189, 248, 0.08), inset 0 1rpx 0 rgba(255, 255, 255, 0.05);
}
.longkong-state.cold {
  border-color: rgba(96, 165, 250, 0.28);
  box-shadow: 0 0 32rpx rgba(96, 165, 250, 0.08), inset 0 1rpx 0 rgba(255, 255, 255, 0.05);
}

.longkong-state-head {
  text-align: center;
  margin-bottom: 20rpx;
}

.longkong-state-title {
  display: inline-block;
  font-size: 24rpx;
  font-weight: 600;
  color: var(--mr-text-muted);
  letter-spacing: 0.12em;
  padding: 6rpx 28rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.04);
  border: 1rpx solid rgba(255, 255, 255, 0.06);
}

.longkong-state-hero {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  text-align: center;
  gap: 8rpx;
  padding: 20rpx 24rpx 18rpx;
  margin-bottom: 16rpx;
  border-radius: 20rpx;
  background: rgba(255, 255, 255, 0.03);
  border: 1rpx solid rgba(255, 255, 255, 0.06);
}

.longkong-state-hero.frenzy,
.longkong-state-hero.climax,
.longkong-state-hero.optimistic {
  color: #f87171;
  background: linear-gradient(135deg, rgba(248, 113, 113, 0.14), rgba(248, 113, 113, 0.04));
  border-color: rgba(248, 113, 113, 0.22);
}
.longkong-state-hero.neutral {
  color: #fbbf24;
  background: linear-gradient(135deg, rgba(251, 191, 36, 0.14), rgba(251, 191, 36, 0.04));
  border-color: rgba(251, 191, 36, 0.22);
}
.longkong-state-hero.caution {
  color: #4ade80;
  background: linear-gradient(135deg, rgba(74, 222, 128, 0.12), rgba(74, 222, 128, 0.04));
  border-color: rgba(74, 222, 128, 0.22);
}
.longkong-state-hero.weak {
  color: #38bdf8;
  background: linear-gradient(135deg, rgba(56, 189, 248, 0.14), rgba(56, 189, 248, 0.04));
  border-color: rgba(56, 189, 248, 0.22);
}
.longkong-state-hero.cold {
  color: #60a5fa;
  background: linear-gradient(135deg, rgba(96, 165, 250, 0.14), rgba(96, 165, 250, 0.04));
  border-color: rgba(96, 165, 250, 0.22);
}

.longkong-state-hero-dot {
  flex-shrink: 0;
  width: 20rpx;
  height: 20rpx;
  margin-bottom: 0;
  border-radius: 50%;
  background: currentColor;
  box-shadow: 0 0 24rpx currentColor;
}

.longkong-state-titleline {
  display: flex;
  align-items: baseline;
  justify-content: center;
  gap: 16rpx;
  flex-wrap: wrap;
  max-width: 100%;
}

.longkong-state-active {
  display: inline;
  font-size: 40rpx;
  font-weight: 800;
  line-height: 1.2;
  letter-spacing: 0.08em;
}

.longkong-state-active.frenzy { color: #ef4444; }
.longkong-state-active.climax,
.longkong-state-active.optimistic { color: #f87171; }
.longkong-state-active.neutral { color: #fbbf24; }
.longkong-state-active.caution { color: #4ade80; }
.longkong-state-active.weak { color: #38bdf8; }
.longkong-state-active.cold { color: #60a5fa; }

.longkong-state-level {
  display: inline;
  font-size: 28rpx;
  font-weight: 700;
  line-height: 1.2;
  letter-spacing: 0.04em;
  opacity: 0.92;
}

.longkong-state-level.calculating { color: var(--mr-text-secondary); }
.longkong-state-level.frenzy { color: #ef4444; }
.longkong-state-level.climax,
.longkong-state-level.optimistic { color: #f87171; }
.longkong-state-level.neutral { color: #fbbf24; }
.longkong-state-level.caution { color: #4ade80; }
.longkong-state-level.weak { color: #38bdf8; }
.longkong-state-level.cold { color: #60a5fa; }

.longkong-lights {
  display: flex;
  gap: 12rpx;
}

.longkong-light {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  min-height: 96rpx;
  padding: 16rpx 10rpx;
  border-radius: 18rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.05);
  background: rgba(0, 0, 0, 0.15);
  color: var(--mr-text-muted);
  opacity: 0.45;
}

.longkong-light.is-active {
  opacity: 1;
  background: rgba(255, 255, 255, 0.05);
}

.longkong-light.is-active.frenzy,
.longkong-light.is-active.climax,
.longkong-light.is-active.optimistic {
  color: #f87171;
  border-color: rgba(248, 113, 113, 0.45);
  background: rgba(248, 113, 113, 0.1);
}
.longkong-light.is-active.neutral {
  color: #fbbf24;
  border-color: rgba(251, 191, 36, 0.45);
  background: rgba(251, 191, 36, 0.1);
}
.longkong-light.is-active.caution {
  color: #4ade80;
  border-color: rgba(74, 222, 128, 0.4);
  background: rgba(74, 222, 128, 0.08);
}
.longkong-light.is-active.weak {
  color: #38bdf8;
  border-color: rgba(56, 189, 248, 0.45);
  background: rgba(56, 189, 248, 0.1);
}
.longkong-light.is-active.cold {
  color: #60a5fa;
  border-color: rgba(96, 165, 250, 0.45);
  background: rgba(96, 165, 250, 0.1);
}

.longkong-light-dot {
  width: 22rpx;
  height: 22rpx;
  border-radius: 50%;
  background: currentColor;
}

.longkong-light.is-active .longkong-light-dot {
  width: 26rpx;
  height: 26rpx;
  box-shadow: 0 0 20rpx currentColor;
  animation: light-dot-pulse 1.6s ease-in-out infinite;
}

@keyframes light-dot-pulse {
  0%, 100% { opacity: 1; box-shadow: 0 0 20rpx currentColor; }
  50% { opacity: 0.35; box-shadow: 0 0 6rpx currentColor; }
}

.longkong-light-label {
  font-size: 26rpx;
  font-weight: 500;
  color: inherit;
  line-height: 1.2;
  opacity: 0.85;
}

.longkong-light.is-active .longkong-light-label {
  font-size: 28rpx;
  font-weight: 700;
  opacity: 1;
}

.longkong-state-desc {
  display: block;
  max-width: 560rpx;
  font-size: 26rpx;
  font-weight: 500;
  line-height: 1.45;
  opacity: 0.88;
}

.longkong-state-desc.frenzy { color: #ef4444; }
.longkong-state-desc.climax,
.longkong-state-desc.optimistic { color: #fca5a5; }
.longkong-state-desc.neutral { color: #fcd34d; }
.longkong-state-desc.caution { color: #86efac; }
.longkong-state-desc.weak { color: #7dd3fc; }
.longkong-state-desc.cold { color: #93c5fd; }

.longkong-state-subdesc {
  display: block;
  max-width: 560rpx;
  font-size: 24rpx;
  font-weight: 500;
  line-height: 1.45;
  opacity: 0.72;
}

.longkong-state-subdesc.frenzy { color: #ef4444; }
.longkong-state-subdesc.climax,
.longkong-state-subdesc.optimistic { color: #fca5a5; }
.longkong-state-subdesc.neutral { color: #fcd34d; }
.longkong-state-subdesc.caution { color: #86efac; }
.longkong-state-subdesc.weak { color: #7dd3fc; }
.longkong-state-subdesc.cold { color: #93c5fd; }

.gauge-foot {
  text-align: center;
  padding: 0 8rpx 4rpx;
  margin-top: -4rpx;
}

.gauge-baseline-row {
  display: flex;
  flex-wrap: wrap;
  align-items: baseline;
  justify-content: center;
}

.gauge-baseline {
  font-size: 26rpx;
  font-weight: 600;
  color: var(--mr-text-secondary);
  letter-spacing: 0.5rpx;
  line-height: 1.35;
}

.gauge-baseline-hint {
  font-size: 22rpx;
  font-weight: 400;
  color: var(--mr-text-muted, #9ca3af);
  line-height: 1.35;
  letter-spacing: 0.25rpx;
}

.gauge-body {
  position: relative;
  height: 360rpx;
}

.gauge-canvas {
  width: 100%;
  height: 360rpx;
  display: block;
}

.gauge-hub {
  position: absolute;
  left: 0;
  right: 0;
  top: 54%;
  transform: translateY(-62%);
  display: flex;
  flex-direction: column;
  align-items: center;
  pointer-events: none;
  z-index: 2;
}

.gauge-score {
  display: block;
  font-size: 108rpx;
  font-weight: 700;
  line-height: 1;
  font-variant-numeric: tabular-nums;
}

.gauge-score.optimistic { color: #f87171; }
.gauge-score.climax { color: #f87171; }
.gauge-score.frenzy { color: #ef4444; }
.gauge-score.neutral { color: #fbbf24; }
.gauge-score.caution { color: #4ade80; }
.gauge-score.cold { color: #60a5fa; }

.gauge-dots {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8px;
  height: 48px;
  margin-bottom: 4rpx;
}

.gauge-dot {
  width: 6px;
  height: 6px;
  border-radius: 50%;
  background: var(--mr-gauge-dot);
  animation: gauge-dot-pulse 1.2s ease-in-out infinite;
}

.gauge-dot:nth-child(2) { animation-delay: 0.15s; }
.gauge-dot:nth-child(3) { animation-delay: 0.3s; }

@keyframes gauge-dot-pulse {
  0%, 80%, 100% { opacity: 0.4; }
  40% { opacity: 1; }
}

.gauge-score-label {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 4rpx;
  display: block;
  font-size: 24rpx;
  font-weight: 500;
  color: var(--mr-text-muted);
  margin-top: 0;
  line-height: 1;
  text-align: center;
}

.gauge-share {
  position: absolute;
  right: 0;
  bottom: 8rpx;
  z-index: 3;
}

.empty-tip {
  margin-top: 16rpx;
  padding: 16rpx;
  background: var(--mr-empty-tip-bg);
  border-radius: 12rpx;
  border: 1rpx solid var(--mr-empty-tip-border);
  font-size: 24rpx;
  font-weight: 400;
  color: #fca5a5;
  text-align: center;
  line-height: 1.5;
}

.section {
  margin-bottom: 24rpx;
}

.section-card {
  padding: 16rpx;
}

.section-card--drill {
  transition: opacity 0.15s ease;
}

.peripheral-row {
  display: flex;
  flex-direction: row;
  gap: 16rpx;
}

.peripheral-cell {
  flex: 1;
  width: 0;
  text-align: center;
  padding: 20rpx 8rpx;
  background: var(--mr-bg-cell);
  border-radius: 12rpx;
  border: 1rpx solid var(--mr-border-light);
}

.peripheral-label {
  display: block;
  font-size: 24rpx;
  font-weight: 400;
  color: var(--mr-text-muted);
  margin-bottom: 12rpx;
  line-height: 1.35;
}

.peripheral-price {
  display: block;
  font-size: 32rpx;
  font-weight: 700;
  color: var(--mr-text-primary);
  font-variant-numeric: tabular-nums;
  line-height: 1.2;
}

.peripheral-chg {
  display: block;
  font-size: 28rpx;
  font-weight: 600;
  margin-top: 8rpx;
  font-variant-numeric: tabular-nums;
  line-height: 1.3;
}

.mr-grid9-value-row {
  display: flex;
  align-items: center;
  justify-content: center;
  flex-wrap: wrap;
  gap: 4rpx;
}

.advance-num {
  font-size: 32rpx;
  font-weight: 700;
  font-variant-numeric: tabular-nums;
  line-height: 1.2;
}

.advance-sep {
  font-size: 28rpx;
  font-weight: 400;
  color: var(--mr-text-muted);
  margin: 0 2rpx;
}

.sub-num {
  font-size: 24rpx;
  font-weight: 600;
}

.trend-arrow {
  font-size: 24rpx;
  font-weight: 700;
  margin-left: 4rpx;
  line-height: 1;
}

.trend-good { color: #f87171; }
.trend-bad { color: #4ade80; }

.mr-grid9-sub {
  display: flex;
  align-items: center;
  justify-content: center;
  flex-wrap: wrap;
  font-size: 24rpx;
  color: var(--mr-text-muted);
  margin-top: 8rpx;
  line-height: 1.35;
}

.mr-grid9-sub--slot {
  min-height: 32rpx;
}

.mr-grid9-sub-prefix,
.mr-grid9-sub-val {
  color: var(--mr-text-muted);
}

.mr-grid9-label.label-long {
  font-size: 22rpx;
  line-height: 1.35;
}

.section-trend {
  margin-bottom: 16rpx;
}

.trend-card {
  padding: 16rpx 8rpx 8rpx;
}

.trend-canvas {
  width: 100%;
  height: 240rpx;
  display: block;
}

.period-tabs {
  display: flex;
  justify-content: center;
  gap: 12rpx;
  margin-top: 16rpx;
  padding-top: 16rpx;
  border-top: 1rpx solid var(--mr-table-border);
}

.period-tab {
  padding: 8rpx 28rpx;
  border-radius: 20rpx;
  background: var(--mr-day-pill-bg);
  font-size: 24rpx;
  color: var(--mr-text-muted);
}

.period-tab--active {
  background: #f87171;
  color: #1f2937;
}

.grid-empty {
  text-align: center;
  padding: 48rpx 0;
  font-size: 28rpx;
  color: var(--mr-text-muted);
  line-height: 1.5;
}

.page-footer-disclaimer {
  padding: 16rpx 8rpx 24rpx;
  text-align: center;
}

.page-footer-disclaimer__text {
  display: block;
  font-size: 24rpx;
  line-height: 1.5;
  color: var(--mr-text-muted);
}

/* 分享海报弹层：上方全貌缩略预览，下方固定操作栏 */
.share-sheet {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  z-index: 1000;
  display: flex;
  flex-direction: column;
  opacity: 0;
  pointer-events: none;
  transition: opacity 0.25s ease;
}

.share-sheet--show {
  opacity: 1;
  pointer-events: auto;
}

.share-sheet__mask {
  position: absolute;
  inset: 0;
  background: rgba(0, 0, 0, 0.72);
}

.share-sheet__body {
  position: relative;
  z-index: 1;
  flex: 1;
  display: flex;
  flex-direction: column;
  min-height: 0;
  width: 100%;
}

.share-sheet__preview-wrap {
  flex: 1;
  min-height: 0;
  padding: 72rpx 32rpx 20rpx;
  box-sizing: border-box;
  display: flex;
  align-items: flex-start;
  justify-content: center;
  overflow: hidden;
}

.share-sheet__preview {
  display: block;
  width: 100%;
  height: 100%;
  max-height: 100%;
  border-radius: 12rpx;
}

.share-sheet__footer {
  flex-shrink: 0;
  background: var(--mr-bg-card);
  border-radius: 20rpx 20rpx 0 0;
  box-shadow: 0 -6rpx 24rpx rgba(0, 0, 0, 0.24);
}

.share-sheet__bar {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 16rpx 24rpx 12rpx;
}

.share-sheet__btn {
  flex: 1;
  height: 64rpx;
  line-height: 64rpx;
  text-align: center;
  font-size: 26rpx;
  font-weight: 500;
  border-radius: 12rpx;
  background: var(--mr-bg-cell);
  border: 1rpx solid var(--mr-border-light);
  color: var(--mr-text-primary);
}

.share-sheet__btn--save {
  color: #f87171;
  border-color: rgba(248, 113, 113, 0.3);
}

.share-sheet__btn--forward {
  color: var(--mr-text-primary);
}

.share-sheet__btn--cancel {
  flex: 0.85;
  color: var(--mr-text-muted);
  background: transparent;
  border-color: transparent;
}

.share-sheet__btn--disabled {
  opacity: 0.55;
}

.share-sheet__btn:active:not(.share-sheet__btn--disabled) {
  opacity: 0.82;
}

.share-sheet__safe {
  height: env(safe-area-inset-bottom);
}

/* ── 状态栏 ── */
.status-bar {
  text-align: center;
  padding: 6rpx 0 14rpx;
  margin-bottom: 4rpx;
}
.status-bar-text {
  font-size: 24rpx;
  color: var(--mr-text-muted);
}
.status-bar--ok .status-bar-text {
  color: var(--mr-green, #4ade80);
}

/* ── 概念集中度柱状图 ── */
.sector-bars-card {
  padding: 20rpx 24rpx 16rpx;
  margin-top: 12rpx;
}
.sector-bar-row {
  display: flex;
  align-items: center;
  margin-bottom: 12rpx;
}
.sector-bar-name {
  width: 140rpx;
  font-size: 22rpx;
  color: var(--mr-text-muted);
  flex-shrink: 0;
}
.sector-bar-track {
  flex: 1;
  height: 10rpx;
  border-radius: 6rpx;
  background: rgba(255,255,255,0.08);
  overflow: hidden;
  margin: 0 16rpx;
}
.sector-bar-fill {
  height: 100%;
  border-radius: 6rpx;
  background: var(--mr-accent, #fbbf24);
  min-width: 8rpx;
}
.sector-bar-count {
  font-size: 22rpx;
  color: var(--mr-text-muted);
  width: 90rpx;
  text-align: right;
  flex-shrink: 0;
}
