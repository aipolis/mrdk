@import '../../styles/theme.wxss';
@import '../../styles/quote.wxss';

.page {
  padding-top: 0;
}

.header--fixed {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  z-index: 200;
  padding-left: 32rpx;
  padding-right: 32rpx;
  padding-bottom: 24rpx;
  background: var(--mr-bg-page);
  border-bottom: 1rpx solid var(--mr-border-light);
  box-sizing: border-box;
}

.header-cap-safe {
  width: 100%;
  flex-shrink: 0;
}

.header-row {
  position: relative;
  display: flex;
  align-items: center;
  min-height: 40px;
  width: 100%;
  box-sizing: border-box;
}

.header-left {
  display: flex;
  align-items: center;
  gap: 16rpx;
  flex: 1;
  min-width: 0;
  padding-right: 16rpx;
}

.header-right {
  position: absolute;
  right: 0;
  top: 0;
  bottom: 0;
  display: flex;
  align-items: center;
  justify-content: flex-end;
  gap: 12rpx;
  flex-shrink: 0;
}

.header-spacer {
  flex-shrink: 0;
}

.header-date {
  font-size: 24rpx;
  font-weight: 400;
  color: var(--mr-text-secondary);
  line-height: 1.4;
  white-space: nowrap;
  flex-shrink: 0;
}

.logo-img {
  width: 32px;
  height: 32px;
  border-radius: 8px;
  border: 1px solid var(--mr-logo-border);
}

.brand-name {
  font-size: 36rpx;
  font-weight: 700;
  color: var(--mr-text-headline);
  line-height: 1.25;
}

.loading-wrap { padding-top: 8rpx; }

.sk-card {
  height: 100rpx;
  background: var(--mr-bg-skeleton);
  border-radius: 16rpx;
  margin-bottom: 16rpx;
  border: 1rpx solid var(--mr-border-light);
}

.sk-mid { height: 340rpx; }
.sk-short { height: 180rpx; }

/* 与君共勉 */
.quote-bar {
  padding: 24rpx;
  margin-bottom: 24rpx;
}

.quote-bar .mr-pill {
  display: inline-flex;
  margin-bottom: 16rpx;
}

.quote-text {
  display: block;
  font-size: 28rpx;
  color: var(--mr-quote-text);
  line-height: 1.6;
  text-align: center;
}

.quote-hand {
  font-size: 32rpx;
  line-height: 1.65;
  letter-spacing: 0;
  color: var(--mr-quote-hand);
}

.quote-from {
  display: block;
  font-size: 24rpx;
  font-weight: 400;
  color: var(--mr-text-muted);
  margin-top: 16rpx;
  text-align: right;
  line-height: 1.4;
}

/* 情绪仪表盘 */
.gauge-card {
  padding: 24rpx;
  margin-bottom: 24rpx;
}

.gauge-head {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 8rpx;
}

.gauge-title {
  font-size: 32rpx;
  font-weight: 600;
  color: var(--mr-text-primary);
  line-height: 1.35;
}

.gauge-time {
  font-size: 24rpx;
  font-weight: 400;
  color: var(--mr-text-muted);
  line-height: 1.4;
}

.gauge-wheel-wrap {
  position: relative;
}

.gauge-level-row {
  text-align: center;
  padding: 8rpx 0 12rpx;
}

.gauge-level {
  display: block;
  font-size: 32rpx;
  font-weight: 700;
  line-height: 1.3;
}

.gauge-level.optimistic { color: #ff4d4f; }
.gauge-level.climax { color: #ff4d4f; }
.gauge-level.frenzy { color: #cf1322; }
.gauge-level.neutral { color: #faad14; }
.gauge-level.caution { color: #52c41a; }
.gauge-level.cold { color: #1890ff; }
.gauge-level.calculating { color: var(--mr-text-secondary); }

.gauge-desc {
  display: block;
  font-size: 28rpx;
  font-weight: 400;
  color: var(--mr-text-secondary);
  margin-top: 8rpx;
  line-height: 1.5;
  padding: 0 8rpx;
}

.gauge-foot {
  text-align: center;
  padding: 0 8rpx 4rpx;
  margin-top: -4rpx;
}

.gauge-baseline-row {
  display: flex;
  flex-wrap: wrap;
  align-items: baseline;
  justify-content: center;
}

.gauge-baseline {
  font-size: 26rpx;
  font-weight: 600;
  color: var(--mr-text-secondary);
  letter-spacing: 0.5rpx;
  line-height: 1.35;
}

.gauge-baseline-hint {
  font-size: 22rpx;
  font-weight: 400;
  color: var(--mr-text-muted, #9ca3af);
  line-height: 1.35;
  letter-spacing: 0.25rpx;
}

.gauge-body {
  position: relative;
  height: 300rpx;
}

.gauge-canvas {
  width: 100%;
  height: 300rpx;
  display: block;
}

.gauge-hub {
  position: absolute;
  left: 0;
  right: 0;
  top: 58%;
  display: flex;
  flex-direction: column;
  align-items: center;
  pointer-events: none;
  z-index: 2;
}

.gauge-score {
  display: block;
  font-size: 88rpx;
  font-weight: 700;
  line-height: 1;
  font-variant-numeric: tabular-nums;
}

.gauge-score.optimistic { color: #ff4d4f; }
.gauge-score.climax { color: #ff4d4f; }
.gauge-score.frenzy { color: #cf1322; }
.gauge-score.neutral { color: #faad14; }
.gauge-score.caution { color: #52c41a; }
.gauge-score.cold { color: #1890ff; }

.gauge-dots {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8px;
  height: 48px;
  margin-bottom: 4rpx;
}

.gauge-dot {
  width: 6px;
  height: 6px;
  border-radius: 50%;
  background: var(--mr-gauge-dot);
  animation: gauge-dot-pulse 1.2s ease-in-out infinite;
}

.gauge-dot:nth-child(2) { animation-delay: 0.15s; }
.gauge-dot:nth-child(3) { animation-delay: 0.3s; }

@keyframes gauge-dot-pulse {
  0%, 80%, 100% { opacity: 0.4; }
  40% { opacity: 1; }
}

.gauge-score-label {
  display: block;
  font-size: 24rpx;
  font-weight: 500;
  color: var(--mr-text-muted);
  margin-top: 8rpx;
  line-height: 1.4;
}

.gauge-share {
  position: absolute;
  right: 0;
  bottom: 8rpx;
  z-index: 3;
}

.empty-tip {
  margin-top: 16rpx;
  padding: 16rpx;
  background: var(--mr-empty-tip-bg);
  border-radius: 12rpx;
  border: 1rpx solid var(--mr-empty-tip-border);
  font-size: 24rpx;
  font-weight: 400;
  color: #ff7875;
  text-align: center;
  line-height: 1.5;
}

.section {
  margin-bottom: 24rpx;
}

.section-card {
  padding: 16rpx;
}

.peripheral-row {
  display: flex;
  flex-direction: row;
  gap: 16rpx;
}

.peripheral-cell {
  flex: 1;
  width: 0;
  text-align: center;
  padding: 20rpx 8rpx;
  background: var(--mr-bg-cell);
  border-radius: 12rpx;
  border: 1rpx solid var(--mr-border-light);
}

.peripheral-label {
  display: block;
  font-size: 24rpx;
  font-weight: 400;
  color: var(--mr-text-muted);
  margin-bottom: 12rpx;
  line-height: 1.35;
}

.peripheral-price {
  display: block;
  font-size: 32rpx;
  font-weight: 700;
  color: var(--mr-text-primary);
  font-variant-numeric: tabular-nums;
  line-height: 1.2;
}

.peripheral-chg {
  display: block;
  font-size: 28rpx;
  font-weight: 600;
  margin-top: 8rpx;
  font-variant-numeric: tabular-nums;
  line-height: 1.3;
}

.mr-grid9-value-row {
  display: flex;
  align-items: center;
  justify-content: center;
  flex-wrap: wrap;
  gap: 4rpx;
}

.advance-num {
  font-size: 32rpx;
  font-weight: 700;
  font-variant-numeric: tabular-nums;
  line-height: 1.2;
}

.advance-sep {
  font-size: 28rpx;
  font-weight: 400;
  color: var(--mr-text-muted);
  margin: 0 2rpx;
}

.sub-num {
  font-size: 24rpx;
  font-weight: 600;
}

.trend-arrow {
  font-size: 24rpx;
  font-weight: 700;
  margin-left: 4rpx;
  line-height: 1;
}

.trend-good { color: #ff4d4f; }
.trend-bad { color: #52c41a; }

.mr-grid9-sub {
  display: flex;
  align-items: center;
  justify-content: center;
  flex-wrap: wrap;
  font-size: 24rpx;
  color: var(--mr-text-muted);
  margin-top: 8rpx;
  line-height: 1.35;
}

.mr-grid9-sub--slot {
  min-height: 32rpx;
}

.mr-grid9-sub-prefix,
.mr-grid9-sub-val {
  color: var(--mr-text-muted);
}

.mr-grid9-label.label-long {
  font-size: 22rpx;
  line-height: 1.35;
}

.section-trend {
  margin-bottom: 16rpx;
}

.trend-card {
  padding: 16rpx 8rpx 8rpx;
}

.trend-canvas {
  width: 100%;
  height: 240rpx;
  display: block;
}

.period-tabs {
  display: flex;
  justify-content: center;
  gap: 12rpx;
  margin-top: 16rpx;
  padding-top: 16rpx;
  border-top: 1rpx solid var(--mr-table-border);
}

.period-tab {
  padding: 8rpx 28rpx;
  border-radius: 20rpx;
  background: var(--mr-day-pill-bg);
  font-size: 24rpx;
  color: var(--mr-text-muted);
}

.period-tab--active {
  background: #ff4d4f;
  color: #fff;
}

.grid-empty {
  text-align: center;
  padding: 48rpx 0;
  font-size: 28rpx;
  color: var(--mr-text-muted);
  line-height: 1.5;
}

.page-footer-disclaimer {
  padding: 16rpx 8rpx 24rpx;
  text-align: center;
}

.page-footer-disclaimer__text {
  display: block;
  font-size: 24rpx;
  line-height: 1.5;
  color: var(--mr-text-muted);
}

/* 分享海报弹层：上方全貌缩略预览，下方固定操作栏 */
.share-sheet {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  z-index: 1000;
  display: flex;
  flex-direction: column;
  opacity: 0;
  pointer-events: none;
  transition: opacity 0.25s ease;
}

.share-sheet--show {
  opacity: 1;
  pointer-events: auto;
}

.share-sheet__mask {
  position: absolute;
  inset: 0;
  background: rgba(0, 0, 0, 0.72);
}

.share-sheet__body {
  position: relative;
  z-index: 1;
  flex: 1;
  display: flex;
  flex-direction: column;
  min-height: 0;
  width: 100%;
}

.share-sheet__preview-wrap {
  flex: 1;
  min-height: 0;
  padding: 72rpx 32rpx 20rpx;
  box-sizing: border-box;
  display: flex;
  align-items: flex-start;
  justify-content: center;
  overflow: hidden;
}

.share-sheet__preview {
  display: block;
  width: 100%;
  height: 100%;
  max-height: 100%;
  border-radius: 12rpx;
}

.share-sheet__footer {
  flex-shrink: 0;
  background: var(--mr-bg-card);
  border-radius: 20rpx 20rpx 0 0;
  box-shadow: 0 -6rpx 24rpx rgba(0, 0, 0, 0.24);
}

.share-sheet__bar {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 16rpx 24rpx 12rpx;
}

.share-sheet__btn {
  flex: 1;
  height: 64rpx;
  line-height: 64rpx;
  text-align: center;
  font-size: 26rpx;
  font-weight: 500;
  border-radius: 12rpx;
  background: var(--mr-bg-cell);
  border: 1rpx solid var(--mr-border-light);
  color: var(--mr-text-primary);
}

.share-sheet__btn--save {
  color: #ff4d4f;
  border-color: rgba(255, 77, 79, 0.35);
}

.share-sheet__btn--forward {
  color: var(--mr-text-primary);
}

.share-sheet__btn--cancel {
  flex: 0.85;
  color: var(--mr-text-muted);
  background: transparent;
  border-color: transparent;
}

.share-sheet__btn--disabled {
  opacity: 0.55;
}

.share-sheet__btn:active:not(.share-sheet__btn--disabled) {
  opacity: 0.82;
}

.share-sheet__safe {
  height: env(safe-area-inset-bottom);
}
