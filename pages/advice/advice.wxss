.page {
  padding-bottom: 32rpx;
}

.pos-gauge-wrap {
  height: 280rpx;
}

.pos-gauge {
  width: 100%;
  height: 280rpx;
}

.pos-summary {
  text-align: center;
  margin-top: -20rpx;
}

.pos-percent {
  display: block;
  font-size: 56rpx;
  font-weight: 700;
  color: #FF4D4F;
}

.pos-label {
  display: block;
  font-size: 28rpx;
  color: #666666;
  margin-top: 4rpx;
}

.rule-card {
  background: linear-gradient(135deg, #FFF1F0 0%, #FFFFFF 100%);
}

.rule-text {
  font-size: 28rpx;
  color: #666666;
  line-height: 1.7;
}

.range-bar {
  padding: 16rpx 0;
}

.range-track {
  position: relative;
  height: 16rpx;
  background: linear-gradient(90deg, #1890FF 0%, #FAAD14 33%, #FF7875 66%, #FF4D4F 100%);
  border-radius: 8rpx;
}

.range-fill {
  display: none;
}

.range-marker {
  position: absolute;
  top: 50%;
  transform: translate(-50%, -50%);
  width: 24rpx;
  height: 24rpx;
  background: #FFFFFF;
  border: 4rpx solid #FF4D4F;
  border-radius: 50%;
  box-shadow: 0 2rpx 8rpx rgba(255, 77, 79, 0.4);
}

.range-labels {
  display: flex;
  justify-content: space-between;
  margin-top: 16rpx;
  font-size: 22rpx;
  color: #999999;
}

.strategy-list {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.strategy-item {
  display: flex;
  gap: 16rpx;
  align-items: flex-start;
}

.strategy-dot {
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  margin-top: 10rpx;
  flex-shrink: 0;
}

.strategy-content {
  flex: 1;
}

.strategy-head {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 4rpx;
}

.strategy-name {
  font-size: 28rpx;
  font-weight: 600;
  color: #333333;
}

.strategy-range {
  font-size: 22rpx;
  color: #999999;
}

.strategy-action {
  font-size: 24rpx;
  color: #666666;
}

.reminder-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.reminder-item {
  display: flex;
  gap: 12rpx;
  align-items: flex-start;
}

.reminder-dot {
  color: #FF4D4F;
  font-size: 28rpx;
  line-height: 1.4;
}

.reminder-text {
  flex: 1;
  font-size: 26rpx;
  color: #666666;
  line-height: 1.5;
}
