/* 双主题 CSS 变量：根节点 theme-dark / theme-light，默认等同黑底 */

.mr-page {
  --mr-bg-page: #0b1020;
  --mr-bg-card: #151b2b;
  --mr-bg-cell: #101625;
  --mr-bg-skeleton: #151b2b;
  --mr-border: rgba(205, 215, 232, 0.08);
  --mr-border-light: rgba(205, 215, 232, 0.055);
  --mr-text-primary: #d8deea;
  --mr-text-body: #c5ccd9;
  --mr-text-secondary: #8f9bad;
  --mr-text-muted: #657083;
  --mr-text-headline: #e9edf5;
  --mr-quote-text: #cfd5e0;
  --mr-quote-hand: #d9dee8;
  --mr-logo-border: rgba(205, 215, 232, 0.08);
  --mr-icon-btn-bg: #1a2133;
  --mr-icon-btn-border: rgba(205, 215, 232, 0.1);
  --mr-icon-btn-glyph: #9aa5b7;
  --mr-empty-tip-bg: rgba(248, 113, 113, 0.075);
  --mr-empty-tip-border: rgba(248, 113, 113, 0.16);
  --mr-menu-border: rgba(205, 215, 232, 0.055);
  --mr-menu-active: rgba(205, 215, 232, 0.045);
  --mr-pill-bg: rgba(248, 113, 113, 0.09);
  --mr-pill-border: rgba(248, 113, 113, 0.22);
  --mr-day-pill-bg: #151b2b;
  --mr-day-pill-border: rgba(205, 215, 232, 0.08);
  --mr-table-border: rgba(205, 215, 232, 0.08);
  --mr-table-row-border: rgba(205, 215, 232, 0.05);
  --mr-gauge-dot: #657083;
  --mr-theme-toggle-bg: rgba(205, 215, 232, 0.055);
}

.theme-dark {
  --mr-bg-page: #0b1020;
  --mr-bg-card: #151b2b;
  --mr-bg-cell: #101625;
  --mr-bg-skeleton: #151b2b;
  --mr-border: rgba(205, 215, 232, 0.08);
  --mr-border-light: rgba(205, 215, 232, 0.055);
  --mr-text-primary: #d8deea;
  --mr-text-body: #c5ccd9;
  --mr-text-secondary: #8f9bad;
  --mr-text-muted: #657083;
  --mr-text-headline: #e9edf5;
  --mr-quote-text: #cfd5e0;
  --mr-quote-hand: #d9dee8;
  --mr-logo-border: rgba(205, 215, 232, 0.08);
  --mr-icon-btn-bg: #1a2133;
  --mr-icon-btn-border: rgba(205, 215, 232, 0.1);
  --mr-icon-btn-glyph: #9aa5b7;
  --mr-empty-tip-bg: rgba(248, 113, 113, 0.075);
  --mr-empty-tip-border: rgba(248, 113, 113, 0.16);
  --mr-menu-border: rgba(205, 215, 232, 0.055);
  --mr-menu-active: rgba(205, 215, 232, 0.045);
  --mr-pill-bg: rgba(248, 113, 113, 0.09);
  --mr-pill-border: rgba(248, 113, 113, 0.22);
  --mr-day-pill-bg: #151b2b;
  --mr-day-pill-border: rgba(205, 215, 232, 0.08);
  --mr-table-border: rgba(205, 215, 232, 0.08);
  --mr-table-row-border: rgba(205, 215, 232, 0.05);
  --mr-gauge-dot: #657083;
  --mr-theme-toggle-bg: rgba(205, 215, 232, 0.055);
}

.theme-light {
  --mr-bg-page: #f3f4f6;
  --mr-bg-card: #ffffff;
  --mr-bg-cell: #f9fafb;
  --mr-bg-skeleton: #ffffff;
  --mr-border: rgba(15, 23, 42, 0.1);
  --mr-border-light: rgba(15, 23, 42, 0.06);
  --mr-text-primary: #111827;
  --mr-text-body: #374151;
  --mr-text-secondary: #6b7280;
  --mr-text-muted: #9ca3af;
  --mr-text-headline: #0f172a;
  --mr-quote-text: #374151;
  --mr-quote-hand: #1f2937;
  --mr-logo-border: rgba(15, 23, 42, 0.08);
  --mr-icon-btn-bg: #ffffff;
  --mr-icon-btn-border: rgba(15, 23, 42, 0.12);
  --mr-icon-btn-glyph: #6b7280;
  --mr-empty-tip-bg: rgba(255, 77, 79, 0.06);
  --mr-empty-tip-border: rgba(255, 77, 79, 0.2);
  --mr-menu-border: rgba(15, 23, 42, 0.06);
  --mr-menu-active: rgba(15, 23, 42, 0.04);
  --mr-pill-bg: rgba(255, 77, 79, 0.08);
  --mr-pill-border: rgba(255, 77, 79, 0.22);
  --mr-day-pill-bg: #ffffff;
  --mr-day-pill-border: rgba(15, 23, 42, 0.1);
  --mr-table-border: rgba(15, 23, 42, 0.08);
  --mr-table-row-border: rgba(15, 23, 42, 0.05);
  --mr-gauge-dot: #9ca3af;
  --mr-theme-toggle-bg: rgba(15, 23, 42, 0.05);
}
