@import './theme-vars.wxss';
@import './crisp.wxss';

/* 页面容器 */
.mr-page {
  min-height: 100vh;
  padding: 0 32rpx 32rpx;
  padding-bottom: calc(32rpx + env(safe-area-inset-bottom));
  background: var(--mr-bg-page);
  color: var(--mr-text-body, #e8eaed);
  font-family: -apple-system, BlinkMacSystemFont, 'PingFang SC', 'Helvetica Neue', 'Microsoft YaHei', sans-serif;
  font-size: 28rpx;
  font-weight: 400;
  line-height: 1.5;
  box-sizing: border-box;
  -webkit-font-smoothing: antialiased;
}

/* 卡片：实色底 + 1rpx 边框，无模糊阴影 */
.mr-card {
  background: var(--mr-bg-card);
  border-radius: 16rpx;
  border: 1rpx solid var(--mr-border);
  box-sizing: border-box;
}

.mr-card--gauge {
  position: relative;
  overflow: hidden;
}

.mr-card--gauge::before {
  content: '';
  position: absolute;
  left: 0;
  right: 0;
  top: 0;
  height: 2rpx;
  background: #ff4d4f;
  opacity: 0.85;
}

/* 区块标题 */
.mr-section-head {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  margin-bottom: 16rpx;
  padding: 0;
}

.mr-section-title {
  font-size: 32rpx;
  font-weight: 600;
  color: var(--mr-text-primary);
  line-height: 1.35;
}

.mr-section-meta {
  font-size: 24rpx;
  font-weight: 400;
  color: var(--mr-text-muted);
  line-height: 1.4;
}

.mr-pill {
  display: inline-flex;
  align-items: center;
  padding: 6rpx 16rpx;
  border-radius: 6rpx;
  font-size: 24rpx;
  font-weight: 500;
  color: #ff7875;
  background: var(--mr-pill-bg);
  border: 1rpx solid var(--mr-pill-border);
  line-height: 1.3;
}

/* 主题切换 */
.theme-toggle {
  background: var(--mr-theme-toggle-bg) !important;
  border-color: var(--mr-icon-btn-border) !important;
}

.theme-toggle__glyph {
  font-size: 14px;
  line-height: 1;
  color: var(--mr-icon-btn-glyph);
}

/* 九宫格 */
.mr-grid9 {
  width: 100%;
}

.mr-grid9-row {
  display: flex;
  flex-direction: row;
  align-items: stretch;
  margin-bottom: 16rpx;
}

.mr-grid9-row:last-child {
  margin-bottom: 0;
}

.mr-grid9-cell {
  flex: 1;
  width: 0;
  min-width: 0;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
}

.mr-grid9-cell + .mr-grid9-cell {
  margin-left: 16rpx;
}

.mr-grid9-item-inner {
  background: var(--mr-bg-cell);
  border-radius: 12rpx;
  padding: 20rpx 8rpx 18rpx;
  border: 1rpx solid var(--mr-border-light);
  text-align: center;
  box-sizing: border-box;
  flex: 1;
  width: 100%;
  min-height: 148rpx;
  display: flex;
  flex-direction: column;
  justify-content: center;
}

.mr-grid9-value {
  display: block;
  font-size: 32rpx;
  font-weight: 700;
  color: var(--mr-text-primary);
  line-height: 1.2;
  font-variant-numeric: tabular-nums;
}

.mr-grid9-value.up { color: #ff4d4f; }
.mr-grid9-value.down { color: #52c41a; }

.mr-grid9-label {
  display: block;
  font-size: 24rpx;
  font-weight: 400;
  color: var(--mr-text-secondary);
  margin-top: 10rpx;
  line-height: 1.35;
}

.mr-grid9-sub {
  display: block;
  font-size: 24rpx;
  font-weight: 400;
  color: var(--mr-text-muted);
  margin-top: 8rpx;
  line-height: 1.35;
}

.mr-grid9-sub--slot {
  min-height: 32rpx;
}

.mr-level-tag {
  display: inline-block;
  padding: 6rpx 16rpx;
  border-radius: 6rpx;
  font-size: 24rpx;
  font-weight: 500;
  line-height: 1.3;
  border: 1rpx solid transparent;
}

.mr-level-tag.optimistic {
  background: rgba(255, 77, 79, 0.12);
  color: #ff4d4f;
  border-color: rgba(255, 77, 79, 0.22);
}

.mr-level-tag.climax {
  background: rgba(255, 77, 79, 0.14);
  color: #ff4d4f;
  border-color: rgba(255, 77, 79, 0.28);
}

.mr-level-tag.frenzy {
  background: rgba(207, 19, 34, 0.14);
  color: #cf1322;
  border-color: rgba(207, 19, 34, 0.28);
}

.mr-level-tag.neutral {
  background: rgba(250, 173, 20, 0.12);
  color: #faad14;
  border-color: rgba(250, 173, 20, 0.22);
}

.mr-level-tag.caution {
  background: rgba(82, 196, 26, 0.12);
  color: #52c41a;
  border-color: rgba(82, 196, 26, 0.22);
}

.mr-level-tag.cold {
  background: rgba(24, 144, 255, 0.12);
  color: #1890ff;
  border-color: rgba(24, 144, 255, 0.22);
}

.mr-score-color.optimistic { color: #ff4d4f; }
.mr-score-color.climax { color: #ff4d4f; }
.mr-score-color.frenzy { color: #cf1322; }
.mr-score-color.neutral { color: #faad14; }
.mr-score-color.caution { color: #52c41a; }
.mr-score-color.cold { color: #1890ff; }

.mr-up { color: #ff4d4f !important; }
.mr-down { color: #52c41a !important; }
